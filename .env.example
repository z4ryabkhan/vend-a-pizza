# ---- OpenRouter ----
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional: used by OpenRouter for attribution/rankings
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=FounderCouncil AI

# Optional: override the default models used by each council seat.
# Defaults are defined in src/lib/council.ts
COUNCIL_MODEL_STRATEGIST=openai/gpt-4o
COUNCIL_MODEL_RISK=anthropic/claude-3.5-sonnet
COUNCIL_MODEL_RESEARCHER=google/gemini-pro-1.5
COUNCIL_MODEL_BUILDER=deepseek/deepseek-chat
COUNCIL_MODEL_CHAIRMAN=openai/gpt-4o

# ---- Supabase ----
# From your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Used by API routes to write council results.
# Keep this secret — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
